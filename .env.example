# Local runs only. Production values live in GitHub Actions secrets:
#   gh secret set LEETCODE_SESSION
#   gh secret set LEETCODE_CSRF_TOKEN
#
# Where to get them: DevTools -> Application -> Cookies -> https://leetcode.com
#   LEETCODE_SESSION   the long session cookie (expires every 1-2 weeks)
#   csrftoken          the 32-character token
#
# See docs/RUNBOOK.md. Prefer keeping the real file OUTSIDE this repo
# (~/.leetcode.env) so a public repo can never publish it by accident.

LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=
